function handleFileSelect(file) {
  if (!file) return;
  if (!file.type.startsWith("image/")) {
    showToast("사진(이미지) 파일만 업로드할 수 있어요!");
    return;
  }

  const reader = new FileReader();
  reader.onload = (e) => {
    const img = new Image();
    img.onload = () => {
      // 최대 가로/세로 720px로 리사이징 및 JPEG 0.72 품질 압축 (약 40~80KB)
      const MAX_SIZE = 720;
      let width = img.width;
      let height = img.height;

      if (width > height && width > MAX_SIZE) {
        height = Math.round((height * MAX_SIZE) / width);
        width = MAX_SIZE;
      } else if (height >= width && height > MAX_SIZE) {
        width = Math.round((width * MAX_SIZE) / height);
        height = MAX_SIZE;
      }

      const canvas = document.createElement("canvas");
      canvas.width = width;
      canvas.height = height;
      const ctx = canvas.getContext("2d");
      ctx.drawImage(img, 0, 0, width, height);

      compressedPhotoDataUrl = canvas.toDataURL("image/jpeg", 0.75);

      const previewImg = document.getElementById("photoPreviewImg");
      previewImg.src = compressedPhotoDataUrl;
      document.getElementById("photoPlaceholder").classList.add("hidden");
      document.getElementById("photoPreviewWrap").classList.remove("hidden");
    };
    img.src = e.target.result;
  };
  reader.readAsDataURL(file);
}

